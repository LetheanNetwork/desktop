go 1.26.2

// Workspace mode for development: pulls fresh code from external/ submodules.
//
// Devs:   git clone --recursive   →   go.work picks up local sources, latest dev.
//
// Submodule pins live in .gitmodules + the recorded SHA per submodule entry.
// Bump a single dep:   git submodule update --remote external/<name>
//
// dappco.re/go is pinned at our external/go (top-level). go-ai's nested
// copies of go-io / go-i18n / go-inference are unused — we pin those at
// our top level for self-consistent build state.

use (
	./external/ai/external/go-log/go
	./external/ai/external/go-rag/go
	./external/ai/external/go-ratelimit/go
	./external/ai/go
	./external/go
	./external/i18n/go
	./external/inference/go
	./external/io/go
	./external/process/go
	./external/store/go
	./external/stream/go
	./external/ws/go
	./go
)
