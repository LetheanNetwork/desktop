go 1.26.2

// Workspace mode for development: pulls fresh code from external/ submodules.
//
// Devs:   git clone --recursive   →   go.work picks up local sources, latest dev.
//
// Submodule pins live in .gitmodules + the recorded SHA per submodule entry.
// Bump a single dep:   git submodule update --remote external/<name>
//
// dappco.re/go is pinned at our external/go (top-level). go-ai's nested
// copies of go-io / go-i18n / go-inference are unused — we pin those at
// our top level for self-consistent build state.

use (
	./external/ai/external/go-log/go
	./external/ai/external/go-rag/go
	./external/ai/external/go-ratelimit/go
	./external/ai/go
	./external/api/external/go-proxy/go
	// api's nested submodules — scm + proxy aren't at our top level
	// so they need to come from the api submodule's tree. The other
	// nested ones (go-ws, go-log, go-io, go-inference, go-process)
	// are already covered by our top-level entries; first-listed wins
	// in workspace resolution, so the top-level pins take precedence.
	./external/api/external/go-scm/go
	./external/api/go
	./external/config/go
	./external/container/go
	./external/go
	./external/gui/go
	./external/i18n/go
	./external/inference/go
	./external/io/go
	./external/mcp/go
	// mcp's nested rag is dropped — our top-level
	// external/ai/external/go-rag/go already provides dappco.re/go/rag
	// and Go workspace mode refuses duplicate module paths.
	./external/orm/go
	./external/php/go
	./external/process/go
	./external/store/go
	./external/stream/go
	./external/ws/go
	./go
)
