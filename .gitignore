bin/
node_modules/
dist/
# Keep the Go embed staging directory present in source-only checkouts while
# continuing to ignore every generated frontend asset copied into it.
!go/cmd/lthn/dist/
go/cmd/lthn/dist/*
!go/cmd/lthn/dist/.keep
*.log
.DS_Store
.env
.env.local

# Wails generated
frontend-ng/bindings/

# Go build cache + test artefacts
*.test
*.prof
coverage.out
coverage.html
go/coverage.out
go/coverage.html

# Frontend coverage report
frontend-ng/coverage/

# IDE
.idea/
.vscode/

# macOS bundle artefacts
*.app/
*.dmg
/lthn
go/tests/cli/bin/

# Override global gitignore — Wails build/ scaffold is canonical, NOT a build cache
!build/
!build/**
build/ios/xcode/
build/android/overlay.json
build/android/gen/
build/android/.gradle/
build/android/app/build/
build/android/app/src/main/jniLibs/

# Task runner cache
.task/
go/lthn

# openapi-generator-cli drops this where it's invoked from. Version
# pinning lives in package.json / `task api:sdk:typescript` — this
# file is a per-tree side effect, not configuration we own.
openapitools.json
go/openapitools.json

# Generated SDK flavour trees live in build/sdk/<flavour>/ and are
# their own LetheanNetwork/sdk-<flavour> git repos. lthn/desktop
# only keeps the spec + publish driver in tree; per-flavour content
# lives upstream.
build/sdk/*/
!build/sdk/openapi.yaml
!build/sdk/openapi.json
!build/sdk/publish.sh

# Sonar scanner local cache
.scannerwork/
frontend-lit-ref/
.agents/
.worktrees/
