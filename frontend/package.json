{
  "name": "lthn-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lethean Desktop frontend — Lit primitives from Lethean-5",
  "license": "EUPL-1.2",
  "scripts": {
    "predev": "bun run monaco:sync",
    "prebuild": "bun run monaco:sync",
    "prebuild:dev": "bun run monaco:sync",
    "monaco:sync": "node -e \"require('fs').cpSync('node_modules/monaco-editor/min/vs', 'public/monaco/vs', {recursive: true, force: true})\"",
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@wailsio/runtime": "*",
    "lit": "^3.1.4",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.9.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
