{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*":          ["src/*"],
      "@ui/*":        ["src/lit/*"],
      "@types":       ["src/lit/types"],
      "@service":     ["bindings/dappco.re/lthn/desktop/pkg/desktop/index"],
      "@service/*":   ["bindings/dappco.re/lthn/desktop/pkg/desktop/*"],
      "@models/*":    ["bindings/dappco.re/lthn/desktop/pkg/*/models"],
      "@inference/*": ["bindings/dappco.re/go/inference/*"],
      "@lthn/*":      ["bindings/dappco.re/go/*"],
      "@bindings/*":  ["bindings/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "bindings/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
