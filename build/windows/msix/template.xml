<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lthn.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Lethean\Lethean Desktop">
    </Installer>
    <PackageInformation
        PackageName="Lethean Desktop"
        PackageDisplayName="Lethean Desktop"
        PublisherName="CN=Lethean"
        PublisherDisplayName="Lethean"
        Version="0.1.0.0"
        PackageDescription="Local AI, sovereign by design.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="ai.lthn.desktop"
                Description="Local AI, sovereign by design."
                DisplayName="Lethean Desktop"
                ExecutableName="lthn.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lethean Desktop</DisplayName>
            <PublisherDisplayName>Lethean</PublisherDisplayName>
            <Description>Local AI, sovereign by design.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lthn.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
