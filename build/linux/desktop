[Desktop Entry]
Version=1.0
Name=Lethean Desktop
Comment=Local AI, sovereign by design.
# %U passes a selected .lthn document or lthn:// URL to the CLI router,
# which starts the native desktop host before Wails translates the argument.
Exec=/usr/local/bin/lthn %U
Terminal=false
Type=Application
Icon=lthn
Categories=Utility;Development;
StartupWMClass=lthn
StartupNotify=true
MimeType=x-scheme-handler/lthn;application/x-lethean;
