<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>lthn</string>
		<key>CFBundleGetInfoString</key>
		<string>lthn — Lethean Desktop</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<!--
		  CFBundleIconName intentionally omitted. The Icon Composer pipeline
		  (appicon.icon + Assets.car) is dropped — see build/Taskfile.yml
		  `generate:icons` for the rationale. Without Assets.car, macOS
		  falls back to CFBundleIconFile = icons.icns, which is derived from
		  build/appicon.png. Re-add this key when we have a proper Lethean
		  .icon Composer descriptor and Assets.car comes back into play.
		-->
		<key>CFBundleIdentifier</key>
		<string>ai.lthn.desktop</string>
		<key>CFBundleName</key>
		<string>Lethean Desktop</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.1.0</string>
		<key>CFBundleVersion</key>
		<string>0.1.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>© 2026, Lethean (EUPL-1.2)</string>
	</dict>
</plist>