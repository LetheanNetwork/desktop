<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>lthn</string>
		<key>CFBundleGetInfoString</key>
		<string>lthn — Lethean Desktop</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<!--
		  CFBundleIconName re-enabled — appicon.icon/Assets/wails_icon_vector.svg
		  was replaced with our Lethean hoplite silhouette (traced from
		  hoplite_white_trans.png, recoloured to Lethean violet #663399 for
		  light-mode rendering). Apple's Icon Composer .icon descriptor
		  (appicon.icon/icon.json) defines automatic dark + tinted variants
		  from this single silhouette. macOS now prefers Assets.car via this
		  key, getting the proper themed Lethean icon across light / dark /
		  tinted appearances. CFBundleIconFile = icons.icns is kept as the
		  legacy fallback for pre-macOS-14 systems.
		-->
		<key>CFBundleIconName</key>
		<string>appicon</string>
		<key>CFBundleIdentifier</key>
		<string>ai.lthn.desktop</string>
		<key>CFBundleName</key>
		<string>Lethean Desktop</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.1.0</string>
		<key>CFBundleVersion</key>
		<string>0.1.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>© 2026, Lethean (EUPL-1.2)</string>
	</dict>
</plist>