<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>lthn</string>
		<key>CFBundleGetInfoString</key>
		<string>lthn — Lethean Desktop</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<!--
		  CFBundleIconName intentionally omitted. The wails3 scaffold ships
		  build/appicon.icon/Assets/wails_icon_vector.svg (the wails W) and
		  the generate:icons step builds Assets.car from that. Modern macOS
		  prefers Assets.car (via CFBundleIconName) over icons.icns (via
		  CFBundleIconFile) — so leaving CFBundleIconName=appicon makes the
		  Dock show the wails W instead of our Lethean logo. Dropping the key
		  forces the older CFBundleIconFile path, which IS regenerated from
		  build/appicon.png (the Lethean logo).
		  Long-term: replace appicon.icon/Assets/wails_icon_vector.svg with a
		  Lethean SVG so Assets.car gets generated from the real brand asset,
		  then re-add CFBundleIconName here.
		-->
		<key>CFBundleIdentifier</key>
		<string>ai.lthn.desktop</string>
		<key>CFBundleName</key>
		<string>Lethean Desktop</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.1.0</string>
		<key>CFBundleVersion</key>
		<string>0.1.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>© 2026, Lethean (EUPL-1.2)</string>
	</dict>
</plist>